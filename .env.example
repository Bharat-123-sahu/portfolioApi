NODE_ENV=production
PORT=5000

# Use at least 32 characters in production.
JWT_SECRET=change-this-to-a-long-random-production-secret
JWT_EXPIRE=7d

# Required to create an admin through POST /api/v1/admin/auth/setup-admin.
# Use at least 32 random characters and do not put this value in frontend code.
ADMIN_SETUP_TOKEN=change-this-to-a-long-random-admin-setup-token

# Local Docker MongoDB defaults. For MongoDB Atlas, set MONGODB_USERNAME,
# MONGODB_PASSWORD, and MONGODB_HOST instead.
MONGODB_DATABASE=portfolio
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_HOST=
# Usually admin for MongoDB Atlas database users.
MONGODB_AUTH_SOURCE=admin

# Optional production/runtime tuning.
CORS_ORIGINS=http://localhost:8080,https://your-domain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
UPLOAD_MAX_FILE_SIZE=5242880
