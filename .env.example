NODE_ENV=production
PORT=5000

# Public URL(s) allowed to call the API. Comma-separate multiple origins.
CORS_ORIGINS=http://localhost:8080,https://your-domain.com

# Use at least 32 characters in production.
JWT_SECRET=change-this-to-a-long-random-production-secret

# Local Docker MongoDB defaults. For MongoDB Atlas, set MONGODB_USERNAME,
# MONGODB_PASSWORD, and MONGODB_HOST instead.
MONGODB_DATABASE=portfolio
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_HOST=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
UPLOAD_MAX_FILE_SIZE=5242880
